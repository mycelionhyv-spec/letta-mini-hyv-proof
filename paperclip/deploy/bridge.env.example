# Copy outside Git, chmod 600, fill on the persistent host. Never publish this populated file.
# Empty secrets and unresolved IDs intentionally cannot run a task.
MYHYV_BRIDGE_ROSTER=/ABSOLUTE/PRIVATE/PATH/roster.json
MYHYV_BRIDGE_LEDGER=/ABSOLUTE/PRIVATE/PATH/bridge/ledger.json
MYHYV_BRIDGE_PORT=8765
MYHYV_PAPERCLIP_COMPANY_ID=
MYHYV_BRIDGE_WEBHOOK_TOKEN=
PAPERCLIP_API_URL=http://127.0.0.1:3100
PAPERCLIP_API_KEY=
LETTA_BIN=/ABSOLUTE/PATH/TO/letta
LETTA_LOCAL_BACKEND_DIR=/ABSOLUTE/PATH/TO/CONFIRMED/LETTA/STORE
# Retain the existing authorized provider configuration. No provider/model override here.
