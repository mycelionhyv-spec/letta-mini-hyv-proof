# Set these on the Paperclip server process, not only on the bridge.
PAPERCLIP_HTTP_ADAPTER_PRIVATE_ENDPOINT_ALLOWLIST=http://127.0.0.1:8765
PAPERCLIP_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
# Separately configure authenticated/private with server.bind=loopback.
# A loopback bind alone does not enable Paperclip user authentication.
