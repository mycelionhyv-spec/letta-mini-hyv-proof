# Copy to .env (never commit secrets).
# This proof uses Letta Code local backend (free, no Letta account).
# Model inference uses an xAI key already present in the environment.

# Required for Grok models:
# XAI_API_KEY=xai-...

# Optional: Letta Cloud (NOT used in this proof; would be needed for
# Cloud free-tier managed agents and REST Groups / send_message_to_agent).
# LETTA_API_KEY=
# LETTA_BASE_URL=https://api.letta.com
